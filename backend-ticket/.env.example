# Compose database credentials. Use a random URL-safe password (openssl rand -hex 32).
POSTGRES_DB=backend-ticket
POSTGRES_USER=backend-ticket
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Local Go commands use DATABASE_URL; Compose derives its own URL using backend-ticket-db:5432.
DATABASE_URL=postgres://backend-ticket:replace-with-a-random-hex-password@localhost:5432/backend-ticket?sslmode=disable
HTTP_ADDR=:8080
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8084
# Reuse the EXISTING ticket client and its registered public HTTPS callback.
OIDC_ISSUER=https://auth.example.com/application/o/ticket/
OIDC_CLIENT_ID=ticket
OIDC_CLIENT_SECRET=replace-with-existing-ticket-client-secret
OIDC_REDIRECT_URI=https://ticket.example.com/api/auth/callback
SESSION_LIFETIME=24h
SESSION_IDLE_TIMEOUT=1h
# Optional tests only: a dedicated disposable PostgreSQL database (isolated schemas are created and dropped).
# TEST_DATABASE_URL=postgres://backend-ticket:password@localhost:5432/backend-ticket_test?sslmode=disable

BUDDY_API_KEY=replace-with-random-buddy-key
TICKET_API_KEY=use-the-same-key-as-tracker
TRACKER_URL=http://backend-tracker:8080
TRACKER_TIMEOUT=5s
# Only seed uses these; they are not passed to server.
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_API_TOKEN=replace-with-admin-api-token
