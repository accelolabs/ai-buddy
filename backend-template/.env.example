# Compose database credentials. Use a random URL-safe password (openssl rand -hex 32).
POSTGRES_DB=backend-template
POSTGRES_USER=backend-template
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Local Go commands use DATABASE_URL; Compose derives its own URL using db:5432.
DATABASE_URL=postgres://backend-template:replace-with-a-random-hex-password@localhost:5432/backend-template?sslmode=disable
HTTP_ADDR=:8080
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8080
# Reuse buddy, wiki, tracker or ticket and its EXISTING registered public callback.
OIDC_ISSUER=https://auth.example.com/application/o/buddy/
OIDC_CLIENT_ID=buddy
OIDC_CLIENT_SECRET=replace-with-existing-buddy-client-secret
OIDC_REDIRECT_URI=https://buddy.example.com/api/auth/callback
SESSION_LIFETIME=24h
SESSION_IDLE_TIMEOUT=1h
# Optional tests only: a dedicated disposable PostgreSQL database (tables are dropped).
# TEST_DATABASE_URL=postgres://backend-template:password@localhost:5432/backend-template_test?sslmode=disable
