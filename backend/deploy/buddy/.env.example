# Compose database credentials. Use a random URL-safe password (openssl rand -hex 32).
POSTGRES_DB=backend-buddy
POSTGRES_USER=backend-buddy
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Local Go commands use DATABASE_URL; Compose derives its own URL using backend-buddy-db:5432.
DATABASE_URL=postgres://backend-buddy:replace-with-a-random-hex-password@localhost:5432/backend-buddy?sslmode=disable
HTTP_ADDR=:8080
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8081
# Reuse the EXISTING buddy client and its registered public HTTPS callback.
OIDC_ISSUER=https://auth.example.com/application/o/buddy/
OIDC_CLIENT_ID=buddy
OIDC_CLIENT_SECRET=replace-with-existing-buddy-client-secret
OIDC_REDIRECT_URI=https://buddy.example.com/api/auth/callback
SESSION_LIFETIME=24h
SESSION_IDLE_TIMEOUT=1h
# Optional tests only: a dedicated disposable PostgreSQL database (isolated schemas are created and dropped).
# TEST_DATABASE_URL=postgres://backend-buddy:password@localhost:5432/backend-buddy_test?sslmode=disable

BUDDY_API_KEY=replace-with-random-buddy-key
TRACKER_URL=http://backend-tracker:8080
TICKET_URL=http://backend-ticket:8080
WIKI_URL=http://backend-wiki:8080
WIKI_PUBLIC_URL=https://wiki.example.com
OLLAMA_URL=http://ollama:11434
