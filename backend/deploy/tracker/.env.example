POSTGRES_DB=backend-tracker
POSTGRES_USER=backend-tracker
POSTGRES_PASSWORD=replace-with-random-url-safe-password
# Local commands need a separately reachable PostgreSQL; Compose does not publish it.
DATABASE_URL=postgres://backend-tracker:password@localhost:5432/backend-tracker?sslmode=disable
HTTP_ADDR=:8080
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8083
OIDC_ISSUER=https://auth.example.com/application/o/tracker/
OIDC_CLIENT_ID=tracker
OIDC_CLIENT_SECRET=replace-with-existing-tracker-client-secret
OIDC_REDIRECT_URI=https://tracker.example.com/api/auth/callback
BUDDY_API_KEY=replace-with-random-buddy-key
TICKET_API_KEY=replace-with-different-random-ticket-key
APP_TIMEZONE=Europe/Moscow
SESSION_LIFETIME=24h
SESSION_IDLE_TIMEOUT=1h
# Seed only. Omit the token from the server environment.
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_API_TOKEN=
# Optional isolated PostgreSQL integration tests (temporary schemas are dropped).
# TEST_DATABASE_URL=postgres://backend-tracker:password@localhost:5432/backend-tracker_test?sslmode=disable
