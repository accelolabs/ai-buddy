# Copy to .env. Public URLs: HTTPS origin only, WITHOUT a trailing slash.
AUTHENTIK_PUBLIC_URL=https://auth.example.com
BUDDY_PUBLIC_URL=https://buddy.example.com
WIKI_PUBLIC_URL=https://wiki.example.com
TRACKER_PUBLIC_URL=https://tracker.example.com
TICKET_PUBLIC_URL=https://ticket.example.com

# Rathole on the same host can reach this loopback port.
AUTHENTIK_HTTP_BIND=127.0.0.1
AUTHENTIK_HTTP_PORT=9000
# Set to the actual immediate proxy source CIDR as seen by Authentik.
# Include the Docker bridge gateway if the tunnel connects via the host port.
AUTHENTIK_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# Generate EACH value separately: openssl rand -hex 32
PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.test
AUTHENTIK_BOOTSTRAP_PASSWORD=

BUDDY_CLIENT_SECRET=
WIKI_CLIENT_SECRET=
TRACKER_CLIENT_SECRET=
TICKET_CLIENT_SECRET=

MENTOR_BACKEND_PASSWORD=
INTERN_BACKEND_1_PASSWORD=
INTERN_BACKEND_2_PASSWORD=
MENTOR_PLATFORM_PASSWORD=
INTERN_PLATFORM_1_PASSWORD=
INTERN_PLATFORM_2_PASSWORD=
